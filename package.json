{
  "name": "all-split",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Bill Expense Splitting & Optimized Settlement Web Application",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@all-split/web",
    "build:web": "npm run build --workspace=@all-split/web",
    "lint:web": "npm run lint --workspace=@all-split/web",
    "dev:api": "npm run start:dev --workspace=@all-split/api",
    "build:api": "npm run build --workspace=@all-split/api",
    "lint:api": "npm run lint --workspace=@all-split/api"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrigel/all-split.git"
  },
  "bugs": {
    "url": "https://github.com/shrigel/all-split/issues"
  },
  "homepage": "https://github.com/shrigel/all-split#readme"
}